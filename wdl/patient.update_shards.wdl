        Array[File]? raw_mutect2_bai_out_scattered
        Array[File]? raw_mutect2_artifact_priors_scattered
    }

    # Overlay each scattered shard-output array onto patient.shards in a single pass;
    # an absent or empty array leaves the field unchanged.
