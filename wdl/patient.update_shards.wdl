    Array[File] raw_mutect2_artifact_priors_scattered_arr = select_first([raw_mutect2_artifact_priors_scattered, []])

    scatter (i in range(length(patient.shards))) {
        Shard shard_i = patient.shards[i]
        Shard updated_shard_i = object {
            id: shard_i.id,
            intervals: shard_i.intervals,
            skip: shard_i.skip,
            is_high_mem: shard_i.is_high_mem,
            raw_calls_mutect2_vcf: if length(raw_calls_mutect2_vcf_scattered_arr) > 0 then raw_calls_mutect2_vcf_scattered_arr[i] else shard_i.raw_calls_mutect2_vcf,
            raw_calls_mutect2_vcf_idx: if length(raw_calls_mutect2_vcf_idx_scattered_arr) > 0 then raw_calls_mutect2_vcf_idx_scattered_arr[i] else shard_i.raw_calls_mutect2_vcf_idx,
            raw_mutect2_stats: if length(raw_mutect2_stats_scattered_arr) > 0 then raw_mutect2_stats_scattered_arr[i] else shard_i.raw_mutect2_stats,
            raw_mutect2_bam_out: if length(raw_mutect2_bam_out_scattered_arr) > 0 then raw_mutect2_bam_out_scattered_arr[i] else shard_i.raw_mutect2_bam_out,
            raw_mutect2_bai_out: if length(raw_mutect2_bai_out_scattered_arr) > 0 then raw_mutect2_bai_out_scattered_arr[i] else shard_i.raw_mutect2_bai_out,
